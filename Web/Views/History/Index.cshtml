@model List<Web.Models.ErrorHistory>

@{
    ViewData["Title"] = "Error History";
}

<style>
    body {
        background-color: #020617 !important;
        color: #e5e7eb;
        font-family: Consolas, monospace;
    }

    h2 {
        color: #38bdf8;
        margin-top: 40px;
        margin-bottom: 20px;
        text-shadow: 0 0 12px rgba(56,189,248,0.15);
    }

    table {
        width: 100%;
        border-collapse: collapse;
        background: #020617;
        border: 1px solid #1e293b;
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 40px;
    }

    th {
        background: #0f172a;
        color: #38bdf8;
        padding: 14px;
        text-align: left;
        border-bottom: 1px solid #1e293b;
    }

    td {
        padding: 14px;
        border-bottom: 1px solid #1e293b;
        color: #e5e7eb;
        vertical-align: top;
    }

    tr:hover {
        background: #0b1220;
    }

    textarea {
        width: 100%;
        background: #020617;
        color: #e5e7eb;
        border: 1px solid #1e293b;
        padding: 14px;
        border-radius: 10px;
        font-family: Consolas;
        resize: vertical;
    }

    .ai-btn {
        background: linear-gradient(135deg, #38bdf8, #6366f1);
        color: white;
        border: none;
        padding: 12px 28px;
        border-radius: 999px;
        font-weight: 600;
        letter-spacing: 0.4px;
        cursor: pointer;
        transition: all 0.25s ease;
    }

        .ai-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 0 20px rgba(99,102,241,0.35);
        }

    .learning-panel {
        background: linear-gradient(135deg,#071029,#020617);
        border: 1px solid #1e293b;
        border-left: 4px solid #38bdf8;
        padding: 20px;
        margin-bottom: 50px;
        border-radius: 14px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.35);
    }

        .learning-panel h3 {
            margin-top: 0;
            margin-bottom: 14px;
            color: #38bdf8;
            font-weight: 600;
        }

        .learning-panel ul {
            margin: 0;
            padding-left: 18px;
            line-height: 1.7;
            color: #cbd5f5;
        }

    .warning-panel {
        background: linear-gradient(135deg, #2b0f0f, #3a1212);
        color: #ffb3b3;
        padding: 18px;
        margin-bottom: 35px;
        border-left: 5px solid #ff4d4d;
        border-radius: 12px;
        box-shadow: 0 6px 20px rgba(255,0,0,0.15);
    }

    .mentor-box {
        margin-top: 25px;
        background: #020617;
        border: 1px solid #1e293b;
        border-left: 4px solid #38bdf8;
        box-shadow: 0 0 25px rgba(56,189,248,0.08);
        padding: 18px;
        border-radius: 12px;
        white-space: pre-wrap;
        min-height: 120px;
    }
</style>

@if (ViewBag.Warnings != null && ViewBag.Warnings.Count > 0)
{
    <div class="warning-panel">
        <h3 style="margin-top:0;">Behavior Warnings</h3>
        <ul style="margin-bottom:0;">
            @foreach (var w in ViewBag.Warnings)
            {
                <li>@w</li>
            }
        </ul>
    </div>
}

<h2>Learning Insights</h2>

@if (ViewBag.LearningInsights != null && ViewBag.LearningInsights.Count > 0)
{
    <div class="learning-panel">
        <h3>Your Repeated Patterns</h3>
        <ul>
            @foreach (var insight in ViewBag.LearningInsights)
            {
                <li>@insight</li>
            }
        </ul>
    </div>
}

<h2>Most Frequent Errors</h2>

<table>
    <tr>
        <th>Error</th>
        <th>Times Occurred</th>
    </tr>
    @foreach (var item in ViewBag.CommonErrors)
    {
        <tr>
            <td>@item.Error</td>
            <td>@item.Count</td>
        </tr>
    }
</table>

<h2>Recent Error Analysis</h2>

<table>
    <tr>
        <th>Error</th>
        <th>Code</th>
        <th>Explanation</th>
        <th>Date</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.ErrorMessage</td>
            <td>@item.CodeSnippet</td>
            <td>@item.Explanation</td>
            <td>@item.Date</td>
        </tr>
    }
</table>

<hr />

<h2>AI Learning Mentor</h2>

<div>
    <textarea id="learningQuestion"
              rows="4"
              placeholder="Ask AI about your past errors, concepts or best practices..."></textarea>

    <br /><br />

    <button onclick="askLearningAI()" class="ai-btn">
        Ask AI Mentor
    </button>

    <div id="learningResponse" class="mentor-box"></div>
</div>

<script>
    async function askLearningAI() {

        const question = document.getElementById("learningQuestion").value;

        if (!question || question.trim() === "") {
            document.getElementById("learningResponse").innerText =
                "Please enter a question first.";
            return;
        }

        document.getElementById("learningResponse").innerText =
            "AI is analyzing your question...\n\nPreparing structured learning response...";

        try {
            const response = await fetch("/api/learning/ask", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    question: question
                })
            });

            const data = await response.json();
            document.getElementById("learningResponse").innerText = data.reply;
        }
        catch {
            document.getElementById("learningResponse").innerText =
                "Error connecting to AI service.";
        }
    }
</script>