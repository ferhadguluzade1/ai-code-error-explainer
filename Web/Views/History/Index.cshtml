@model List<Web.Models.ErrorHistory>

@{
    ViewData["Title"] = "Error History";
}

<style>
    body {
        background-color: #020617 !important;
        color: #e5e7eb;
        font-family: Consolas, monospace;
    }

    h2 {
        color: #38bdf8;
        margin-top: 30px;
        text-shadow: 0 0 12px rgba(56,189,248,0.15);
    }

    table {
        width: 100%;
        border-collapse: collapse;
        background: #020617;
        border: 1px solid #1e293b;
        border-radius: 8px;
        overflow: hidden;
        overflow-x: auto;
        display: block;
    }

    th {
        background: #0f172a;
        color: #38bdf8;
        padding: 12px;
        text-align: left;
        border-bottom: 1px solid #1e293b;
    }

    td {
        padding: 12px;
        border-bottom: 1px solid #1e293b;
        color: #e5e7eb;
    }

    tr:hover {
        background: #0b1220;
    }

    textarea {
        width: 100%;
        background: #020617;
        color: #e5e7eb;
        border: 1px solid #1e293b;
        padding: 12px;
        border-radius: 8px;
        font-family: Consolas;
    }

    .ai-btn {
        background: linear-gradient(135deg, #38bdf8, #6366f1);
        color: white;
        border: none;
        padding: 12px 26px;
        border-radius: 999px;
        font-weight: 600;
        letter-spacing: 0.4px;
        cursor: pointer;
        transition: all 0.25s ease;
        box-shadow: 0 0 0 rgba(99,102,241,0);
    }

        .ai-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 0 18px rgba(99,102,241,0.35);
        }

        .ai-btn:active {
            transform: scale(0.98);
        }

    .learning-box {
        margin-top: 20px;
        background: #020617;
        border: 1px solid #1e293b;
        border-left: 4px solid #38bdf8;
        box-shadow: 0 0 25px rgba(56,189,248,0.08);
        padding: 16px;
        border-radius: 8px;
        white-space: pre-wrap;
        min-height: 120px;
    }
</style>


@if (ViewBag.Warnings != null && ViewBag.Warnings.Count > 0)
{
    <div style="
                background: linear-gradient(135deg, #2b0f0f, #3a1212);
                color: #ffb3b3;
                padding:18px;
                margin-bottom:25px;
                border-left:5px solid #ff4d4d;
                border-radius:10px;
                box-shadow:0 4px 20px rgba(255,0,0,0.15);
            ">
        <h3 style="margin-top:0; color:#ff6666;">Behavior Warnings</h3>
        <ul style="margin-bottom:0;">
            @foreach (var w in ViewBag.Warnings)
            {
                <li>@w</li>
            }
        </ul>
    </div>
}

<h2>Most Frequent Errors</h2>

<table>
    <tr>
        <th>Error</th>
        <th>Times Occurred</th>
    </tr>

    @foreach (var item in ViewBag.CommonErrors)
    {
        <tr>
            <td>@item.Error</td>
            <td>@item.Count</td>
        </tr>
    }
</table>

<br />

<h2>Recent Error Analysis</h2>

<table>
    <tr>
        <th>Error</th>
        <th>Code</th>
        <th>Explanation</th>
        <th>Date</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.ErrorMessage</td>
            <td>@item.CodeSnippet</td>
            <td>@item.Explanation</td>
            <td>@item.Date</td>
        </tr>
    }
</table>

<hr />

<h2>AI Learning Mentor</h2>

<div style="margin-top:20px;">

    <textarea id="learningQuestion"
              rows="4"
              placeholder="Ask AI about your past errors, concepts or best practices...">
    </textarea>

    <br /><br />

    <button onclick="askLearningAI()" class="ai-btn">
        Ask AI Mentor
    </button>

    <div id="learningResponse" class="learning-box"></div>

</div>

<script>
    async function askLearningAI() {

        const question = document.getElementById("learningQuestion").value;

        if (!question || question.trim() === "") {
            document.getElementById("learningResponse").innerText =
            "Please enter a question first.";
            return;
        }

        document.getElementById("learningResponse").innerText =
        "AI is analyzing your question...\n\nPreparing structured learning response...";

        try {
            const response = await fetch("/api/learning/ask", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    question: question
                })
            });

            const data = await response.json();

            document.getElementById("learningResponse").innerText = data.reply;
        }
        catch {
            document.getElementById("learningResponse").innerText =
            "Error connecting to AI service.";
        }
    }
</script>