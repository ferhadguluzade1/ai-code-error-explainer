@model List<Web.Models.ErrorHistory>

@{
    ViewData["Title"] = "Error History";
}

@if (ViewBag.Warnings != null && ViewBag.Warnings.Count > 0)
{
    <div style="
            background: linear-gradient(135deg, #2b0f0f, #3a1212);
            color: #ffb3b3;
            padding:18px;
            margin-bottom:25px;
            border-left:5px solid #ff4d4d;
            border-radius:10px;
            box-shadow:0 4px 20px rgba(255,0,0,0.15);
        ">
        <h3 style="margin-top:0; color:#ff6666;">Behavior Warnings</h3>
        <ul style="margin-bottom:0;">
            @foreach (var w in ViewBag.Warnings)
            {
                <li>@w</li>
            }
        </ul>
    </div>
}


<h2>Most Frequent Errors</h2>

<table border="1" cellpadding="10">
    <tr>
        <th>Error</th>
        <th>Times Occurred</th>
    </tr>

    @foreach (var item in ViewBag.CommonErrors)
    {
        <tr>
            <td>@item.Error</td>
            <td>@item.Count</td>
        </tr>
    }
</table>

<br />
<br />

<h2>Recent Error Analysis</h2>

<table border="1" cellpadding="10">
    <tr>
        <th>Error</th>
        <th>Code</th>
        <th>Explanation</th>
        <th>Date</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.ErrorMessage</td>
            <td>@item.CodeSnippet</td>
            <td>@item.Explanation</td>
            <td>@item.Date</td>
        </tr>
    }
</table>

