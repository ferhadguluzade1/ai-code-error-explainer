@model List<Web.Models.ErrorHistory>

@{
    ViewData["Title"] = "Error History";
}
@{
    var stats = ViewBag.Stats;
}
<h3>Learning Progress</h3>
<p>
    You have analyzed <b>@Model.Count()</b> errors using AI.
</p>

<style>
    body {
        background-color: #020617 !important;
        color: #e5e7eb;
        font-family: Consolas, monospace;
    }

    h2 {
        color: #38bdf8;
        margin-top: 40px;
        margin-bottom: 20px;
        text-shadow: 0 0 12px rgba(56,189,248,0.15);
    }

    table {
        width: 100%;
        border-collapse: collapse;
        background: #020617;
        border: 1px solid #1e293b;
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 40px;
    }

    th {
        background: #0f172a;
        color: #38bdf8;
        padding: 14px;
        text-align: left;
        border-bottom: 1px solid #1e293b;
    }

    td {
        padding: 14px;
        border-bottom: 1px solid #1e293b;
        color: #e5e7eb;
        vertical-align: top;
    }

    tr:hover {
        background: #0b1220;
    }

    textarea {
        width: 100%;
        background: #020617;
        color: #e5e7eb;
        border: 1px solid #1e293b;
        padding: 14px;
        border-radius: 10px;
        font-family: Consolas;
        resize: vertical;
    }

    .ai-btn {
        background: linear-gradient(135deg, #38bdf8, #6366f1);
        color: white;
        border: none;
        padding: 12px 28px;
        border-radius: 999px;
        font-weight: 600;
        letter-spacing: 0.4px;
        cursor: pointer;
        transition: all 0.25s ease;
    }

        .ai-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 0 20px rgba(99,102,241,0.35);
        }

    .learning-panel {
        background: linear-gradient(135deg,#071029,#020617);
        border: 1px solid #1e293b;
        border-left: 4px solid #38bdf8;
        padding: 20px;
        margin-bottom: 50px;
        border-radius: 14px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.35);
    }

        .learning-panel h3 {
            margin-top: 0;
            margin-bottom: 14px;
            color: #38bdf8;
            font-weight: 600;
        }

        .learning-panel ul {
            margin: 0;
            padding-left: 18px;
            line-height: 1.7;
            color: #cbd5f5;
        }

    .warning-panel {
        background: linear-gradient(135deg, #2b0f0f, #3a1212);
        color: #ffb3b3;
        padding: 18px;
        margin-bottom: 35px;
        border-left: 5px solid #ff4d4d;
        border-radius: 12px;
        box-shadow: 0 6px 20px rgba(255,0,0,0.15);
    }

    .mentor-box {
        margin-top: 25px;
        background: #020617;
        border: 1px solid #1e293b;
        border-left: 4px solid #38bdf8;
        box-shadow: 0 0 25px rgba(56,189,248,0.08);
        padding: 18px;
        border-radius: 12px;
        white-space: pre-wrap;
        min-height: 120px;
    }

    .learning-box {
        animation: fadeIn 0.4s ease-in-out;
    }

    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: translateY(8px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }
    /* HISTORY ACCORDION */

    .history-card {
        border: 1px solid #1e293b;
        border-radius: 10px;
        margin-bottom: 14px;
        overflow: hidden;
        background: #020617;
    }

    .history-header {
        padding: 14px 16px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #0f172a;
        transition: 0.2s;
    }

        .history-header:hover {
            background: #111827;
        }

    .error-title {
        flex: 1;
        margin-left: 10px;
        color: #38bdf8;
    }

    .history-date {
        color: #94a3b8;
        font-size: 13px;
    }

    .arrow {
        transition: transform 0.25s ease;
    }

    .history-card.open .arrow {
        transform: rotate(90deg);
    }

    .history-body {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.35s ease;
        padding: 0 16px;
    }

    .history-card.open .history-body {
        max-height: 800px;
        padding: 16px;
    }

    .history-section {
        margin-bottom: 14px;
    }

        .history-section pre {
            background: #020617;
            border: 1px solid #1e293b;
            padding: 12px;
            border-radius: 8px;
            white-space: pre-wrap;
        }

    .trend-box {
        background: linear-gradient(135deg,#0f172a,#020617);
        border-left: 4px solid #38bdf8;
        padding: 18px;
        border-radius: 10px;
        margin-bottom: 25px;
        box-shadow: 0 0 20px rgba(56,189,248,0.15);
    }

        .trend-box h3 {
            margin-top: 0;
            color: #38bdf8;
        }

        .trend-box li {
            margin-bottom: 8px;
            color: #e5e7eb;
        }
    /* SECTION SEPARATION */

    .section-divider {
        height: 1px;
        margin: 45px 0 35px 0;
        background: linear-gradient( to right, transparent, #1e293b, transparent );
    }

    .accordion-item {
        margin-bottom: 14px;
    }

    .accordion-header {
        cursor: pointer;
        padding: 14px;
        background: #0b1220;
        border: 1px solid #1e293b;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

        .accordion-header:hover {
            border-color: #38bdf8;
            box-shadow: 0 0 10px rgba(56,189,248,0.15);
        }

    .accordion-content {
        margin-top: 8px;
    }
    /* BEHAVIOR PANEL */

    .behavior-panel {
        margin-bottom: 40px;
        padding: 22px;
        background: linear-gradient(135deg,#020617,#0b1220);
        border: 1px solid #1e293b;
        border-radius: 12px;
        box-shadow: 0 0 30px rgba(56,189,248,0.08);
    }

        .behavior-panel h3 {
            color: #38bdf8;
            margin-bottom: 18px;
        }

    .behavior-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(200px,1fr));
        gap: 18px;
    }

    .behavior-card {
        background: #020617;
        border: 1px solid #1e293b;
        padding: 16px;
        border-radius: 10px;
        min-height: 90px;
    }

        .behavior-card span {
            font-size: 13px;
            color: #94a3b8;
        }

        .behavior-card strong {
            display: block;
            margin-top: 6px;
            font-size: 18px;
            color: #e5e7eb;
            word-break: break-word;
            overflow-wrap: anywhere;
        }

    .skill-box {
        margin-bottom: 25px;
        padding: 18px;
        border: 1px solid #1e293b;
        border-left: 4px solid #6366f1;
        border-radius: 10px;
        background: #020617;
    }

    .skill-badge {
        display: inline-block;
        margin-top: 8px;
        padding: 6px 16px;
        border-radius: 999px;
        background: linear-gradient(135deg,#6366f1,#38bdf8);
        color: white;
        font-weight: 600;
    }
</style>

@if (ViewBag.Warnings != null && ViewBag.Warnings.Count > 0)
{
    <div class="warning-panel">
        <h3 style="margin-top:0;">Behavior Warnings</h3>
        <ul style="margin-bottom:0;">
            @foreach (var w in ViewBag.Warnings)
            {
                <li>@w</li>
            }
        </ul>
    </div>
}
@if (ViewBag.Stats != null)
{
    <div style="
            display:flex;
            gap:20px;
            margin-bottom:25px;
            flex-wrap:wrap;
        ">

        <div class="learning-box">
            <strong>Total Analyses</strong><br />
            @ViewBag.Stats.Total
        </div>

        <div class="learning-box">
            <strong>Most Common Error</strong><br />
            @ViewBag.Stats.MostCommon
        </div>

        <div class="learning-box">
            <strong>Learning Score</strong><br />
            @ViewBag.Stats.Score%
        </div>

    </div>
}
<h2>Learning Insights</h2>

@if (ViewBag.LearningInsights != null && ViewBag.LearningInsights.Count > 0)
{
    <div class="learning-panel">
        <h3>Your Repeated Patterns</h3>
        <ul>
            @foreach (var insight in ViewBag.LearningInsights)
            {
                <li>@insight</li>
            }
        </ul>
    </div>
}
@if (ViewBag.Stats != null)
{
    <div class="learning-box">
        <h3 style="color:#38bdf8;">AI Learning Progress</h3>

        <p>Total Analyses: <b>@ViewBag.Stats.Total</b></p>
        <p>Most Common Error: <b>@ViewBag.Stats.MostCommon</b></p>
        <p>Learning Level: <b>@ViewBag.Stats.Score</b></p>
       
    </div>
}
@if (ViewBag.ProgressInsights != null && ViewBag.ProgressInsights.Count > 0)
{
    <div style="
            background: linear-gradient(135deg,#052e16,#064e3b);
            border-left:5px solid #22c55e;
            padding:18px;
            margin-top:25px;
            border-radius:10px;
            box-shadow:0 4px 20px rgba(34,197,94,0.15);
        ">
        <h3 style="margin-top:0;color:#22c55e;">
            Progress Insights
        </h3>

        <ul>
            @foreach (var p in ViewBag.ProgressInsights)
            {
                <li>@p</li>
            }
        </ul>
    </div>
}
@if (ViewBag.Behavior != null)
{
    <div class="behavior-panel">
        <div class="skill-box">
            <h3>Your AI Skill Level</h3>
            <span class="skill-badge">
                @ViewBag.SkillLevel
            </span>
        </div>
        <h3>AI Behavior Intelligence</h3>

        <div class="behavior-grid">

            <div class="behavior-card">
                <span>Total Analyses</span>
                <strong>@ViewBag.Behavior.TotalAnalyses</strong>
            </div>

            <div class="behavior-card">
                <span>Most Frequent Error</span>
                <strong>@ViewBag.Behavior.MostCommonError</strong>
            </div>

            <div class="behavior-card">
                <span>Occurrences</span>
                <strong>@ViewBag.Behavior.Count</strong>
            </div>

            <div class="behavior-card">
                <span>Learning Trend</span>
                <strong>
                    @(ViewBag.Behavior.Improving
                                    ? "Improving 📈"
                                    : "Needs Practice 📚")
            </strong>
        </div>

        </div>

    </div>
}
<h2>Most Frequent Errors</h2>

<table>
    <tr>
        <th>Error</th>
        <th>Times Occurred</th>
    </tr>
    @foreach (var item in ViewBag.CommonErrors)
    {
        <tr>
            <td>@item.Error</td>
            <td>@item.Count</td>
        </tr>
    }
</table>

<div class="section-divider"></div>

<h2>Recent Error Analysis</h2>

<div class="history-list">

    @foreach (var item in Model)
    {
        <div class="history-card">

            <div class="history-header"
                 onclick="toggleHistory(this)">

                <span class="arrow">▶</span>

                <span class="error-title">
                    @item.ErrorMessage
                </span>

                <span class="history-date">
                    @item.Date.ToString("dd MMM yyyy HH:mm")
                </span>

            </div>

            <div class="history-body">

                <div class="history-section">
                    <strong>Code</strong>
                    <pre>@item.CodeSnippet</pre>
                </div>

                <div class="history-section">
                    <strong>Explanation</strong>
                    <pre>@item.Explanation</pre>
                </div>

            </div>

        </div>
    }

</div>
<hr />

<h2>
    AI Learning Mentor
    <span style="font-size:14px; color:#94a3b8;">
        (Context-Aware Guidance)
    </span>
</h2>

<div>
    <textarea id="learningQuestion"
              rows="4"
              placeholder="Ask AI about your past errors, concepts or best practices..."></textarea>

    <br /><br />

    <button onclick="askLearningAI()" class="ai-btn">
        Ask AI Mentor
    </button>

    <div id="learningResponse" class="mentor-box"></div>
</div>

<script>
    async function askLearningAI() {

        const question = document.getElementById("learningQuestion").value;

        if (!question || question.trim() === "") {
            document.getElementById("learningResponse").innerText =
                "Please enter a question first.";
            return;
        }

        document.getElementById("learningResponse").innerText =
            "AI is analyzing your question...\n\nPreparing structured learning response...";

        try {
            const response = await fetch("/api/learning/ask", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    question: question
                })
            });

            const data = await response.json();
            document.getElementById("learningResponse").innerText = data.reply;
        }
        catch {
            document.getElementById("learningResponse").innerText =
                "Error connecting to AI service.";
        }
    }
    function toggleHistory(header) 
    {

        const card = header.parentElement;

        card.classList.toggle("open");
    }
</script>