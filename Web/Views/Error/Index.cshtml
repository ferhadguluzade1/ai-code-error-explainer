@{
    ViewData["Title"] = "Error Analyzer";
}

<style>
    body {
        background-color: #020617 !important;
        color: #e5e7eb;
        font-family: Consolas, monospace;
        margin: 0;
    }

    .container {
        max-width: 1100px;
        margin: 60px auto;
        padding: 30px;
    }

    h2 {
        color: #38bdf8;
        margin-bottom: 25px;
    }

    textarea {
        width: 100%;
        background-color: #020617;
        color: #e5e7eb;
        border: 1px solid #1e293b;
        padding: 14px;
        border-radius: 8px;
        margin-bottom: 18px;
        font-size: 14px;
    }

        textarea:focus {
            outline: none;
            border-color: #38bdf8;
        }

    button {
        background-color: #38bdf8;
        color: #020617;
        border: none;
        padding: 12px 24px;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        margin-top: 10px;
    }

        button:hover {
            background-color: #0ea5e9;
        }

    .mode-select {
        margin: 18px 0;
    }

    .result-box {
        background: linear-gradient(145deg, #0f172a, #111827);
        border: 1px solid #1e293b;
        padding: 20px;
        border-radius: 12px;
        margin-top: 25px;
        white-space: pre-wrap;
        min-height: 150px;
        box-shadow: 0 0 20px rgba(56,189,248,0.1);
    }

    /* SPLIT LAYOUT */
    .split-layout {
        display: flex;
        gap: 30px;
    }

    /* RESPONSIVE (Razor üçün @@media istifadə olunur) */
    @@media (max-width: 900px) {
        .split-layout {
            flex-direction: column;
        }
    }

    .analyzer-wrapper {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        align-items: start;
        margin-top: 40px;
    }

    .input-panel {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .result-panel {
        background: linear-gradient(145deg,#0b1220,#020617);
        border: 1px solid #1e293b;
        border-radius: 14px;
        padding: 22px;
        min-height: 320px;
        box-shadow: 0 10px 35px rgba(0,0,0,0.35);
    }

    @@media (max-width: 1000px) {
        .analyzer-wrapper

    {
        grid-template-columns: 1fr;
    }

    }

    .split-layout {
        display: flex;
        gap: 40px;
        align-items: flex-start;
        margin-top: 30px;
    }

        .split-layout > div {
            flex: 1;
        }

    .result-box {
        background: linear-gradient(145deg,#0b1220,#020617);
        border: 1px solid #1e293b;
        border-radius: 14px;
        padding: 22px;
        min-height: 340px;
        box-shadow: 0 10px 35px rgba(0,0,0,0.35);
    }

    @@media (max-width: 1000px) {
        .split-layout

    {
        flex-direction: column;
    }

    }
</style>

<div class="container">

    <h2>AI Code Error Explainer</h2>

    <div class="split-layout">

        <!-- LEFT PANEL -->
        <div style="flex:1;">

            <textarea id="errorInput" rows="5" placeholder="Paste your error here..."></textarea>

            <textarea id="codeInput" rows="12" placeholder="Paste your code here..."></textarea>

            <div class="mode-select">
                <label>
                    <input type="radio" name="mode" value="developer" checked>
                    Developer explanation
                </label>

                <label style="margin-left:20px;">
                    <input type="radio" name="mode" value="beginner">
                    Beginner explanation
                </label>
            </div>

            <button onclick="sendError()">Analyze Error</button>

        </div>

        <!-- RIGHT PANEL -->
        <div style="flex:1;">
            <div id="result" class="result-box"></div>
        </div>

    </div>

</div>

<script>
    async function sendError() {

        const resultBox = document.getElementById("result");

        const errorText = document.getElementById("errorInput").value.trim();
        const codeText = document.getElementById("codeInput").value.trim();
        const selectedMode = document.querySelector('input[name="mode"]:checked').value;

        // boş input yoxlanması
        if (errorText === "" && codeText === "") {
            resultBox.innerText =
                "Please provide at least an error message or a code snippet before analyzing.";
            resultBox.style.borderColor = "#ef4444";
            return;
        }

        resultBox.innerText = "Analyzing...";
        resultBox.style.borderColor = "#1e293b";

        const response = await fetch("/api/error/analyze", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                errorMessage: errorText,
                codeSnippet: codeText,
                explanationMode: selectedMode
            })
        });

        const data = await response.json();

        let output =
            "Risk Level: [" + data.riskLevel.toUpperCase() + " RISK]\n\n" +
            "Confidence: " + data.confidence + "%\n\n" +
            "Explanation:\n" + data.explanation + "\n\n" +
            "Suggestion:\n" + data.suggestion;

        if (data.fixedCode) {
            output += "\n\nFixed Code:\n" + data.fixedCode;
        }

        if (data.alternativeFix && data.alternativeFix.length > 0) {
            output += "\n\nAlternative Fix:\n" + data.alternativeFix;
        }

        if (data.aiRequired) {
            output += "\n\nAI deeper analysis triggered...";
        }

        resultBox.innerText = output;

        // risk vizual highlight
        if (data.riskLevel === "High") {
            resultBox.style.borderColor = "#ef4444";
        }
        else if (data.riskLevel === "Medium") {
            resultBox.style.borderColor = "#f59e0b";
        }
        else {
            resultBox.style.borderColor = "#22c55e";
        }
    }
</script>