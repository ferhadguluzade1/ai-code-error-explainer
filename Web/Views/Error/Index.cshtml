@{
    ViewData["Title"] = "Error Analyzer";
}

<h2>Code Error Explainer</h2>

<textarea id="errorInput" rows="6" cols="80" placeholder="Paste your error here..."></textarea>

<br />
<br />

<textarea id="codeInput" rows="10" cols="80" placeholder="Paste your code here..."></textarea>

<br />
<br />

<label>
    <input type="radio" name="mode" value="developer" checked>
    Developer explanation
</label>

<label>
    <input type="radio" name="mode" value="beginner">
    Beginner explanation
</label>

<br />
<br />

<button onclick="sendError()">Analyze</button>

<pre id="result"></pre>

<script>
    async function sendError() {
        const errorText = document.getElementById("errorInput").value;
        const selectedMode = document.querySelector('input[name="mode"]:checked').value;

        const response = await fetch("/api/error/analyze", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                errorMessage: errorText,
                codeSnippet: document.getElementById("codeInput").value,
                explanationMode: selectedMode
            })
        });

        const data = await response.json();

        let output =
            "Confidence: " + data.confidence + "%\n\n" +
            "Explanation: " + data.explanation + "\n\n" +
            "Suggestion: " + data.suggestion;

        if (data.aiRequired) {
            output += "\n\nAI deeper analysis will be triggered...";
        }

        document.getElementById("result").innerText = output;
    }
</script>
