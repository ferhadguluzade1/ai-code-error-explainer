@{
    ViewData["Title"] = "Error Analyzer";
}
<h1 style="color:red;">TEST VIEW WORKS</h1>
<style>
    body {
        background-color: #020617 !important;
        color: #e5e7eb;
        font-family: Consolas,monospace;
        margin: 0;
    }

    h2 {
        color: #38bdf8;
        margin-bottom: 25px;
        text-shadow: 0 0 12px rgba(56,189,248,0.15);
    }

    /* ---------- LAYOUT ---------- */

    .main-container {
        max-width: 1100px;
        margin: 60px auto;
        padding: 20px;
    }

    .analyzer-wrapper {
        display: flex;
        gap: 30px;
        align-items: stretch;
    }

    .panel {
        flex: 1;
        background: #0b1220;
        border: 1px solid #1e293b;
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 0 25px rgba(0,0,0,0.35);
        display: flex;
        flex-direction: column;
    }

    .left-panel textarea {
        width: 100%;
        background: #020617;
        color: #e5e7eb;
        border: 1px solid #1e293b;
        padding: 14px;
        border-radius: 8px;
        margin-bottom: 18px;
        font-family: Consolas;
    }

    textarea:focus {
        outline: none;
        border-color: #38bdf8;
    }

    .mode-select {
        margin: 18px 0;
    }

    button {
        background: linear-gradient(135deg,#38bdf8,#6366f1);
        color: white;
        border: none;
        padding: 12px 26px;
        border-radius: 999px;
        font-weight: 600;
        cursor: pointer;
        transition: .25s;
    }

        button:hover {
            transform: translateY(-1px);
            box-shadow: 0 0 18px rgba(99,102,241,.35);
        }

    .result-box {
        background: #020617;
        border: 1px solid #1e293b;
        padding: 18px;
        border-radius: 8px;
        min-height: 420px;
    }

    /* ---------- AI REPORT ---------- */

    .ai-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

    .risk-badge {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 6px 16px;
        border-radius: 999px;
        font-weight: 600;
        font-size: 13px;
        letter-spacing: .5px;
    }

    .risk-low {
        background: rgba(34,197,94,.15);
        color: #22c55e;
        border: 1px solid #22c55e;
    }

    .risk-medium {
        background: rgba(234,179,8,.15);
        color: #eab308;
        border: 1px solid #eab308;
    }

    .risk-high {
        background: rgba(239,68,68,.15);
        color: #ef4444;
        border: 1px solid #ef4444;
    }

    .ai-section {
        margin-bottom: 18px;
    }

        .ai-section h4 {
            color: #38bdf8;
            margin-bottom: 6px;
        }

        .ai-section pre {
            background: #020617;
            border: 1px solid #1e293b;
            padding: 12px;
            border-radius: 8px;
            white-space: pre-wrap;
        }

    @@media(max-width:900px) {
        .analyzer-wrapper {
            flex-direction: column;
        }
    }

    .ai-title {
        font-size: 18px;
        font-weight: 600;
        color: #38bdf8;
        margin-bottom: 14px;
        letter-spacing: 0.4px;
        border-bottom: 1px solid #1e293b;
        padding-bottom: 8px;
    }

    .panel {
        animation: fadeIn 0.35s ease;
    }


    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: translateY(8px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .loading {
        opacity: 0.6;
        pointer-events: none;
    }

    .ai-loading {
        color: #38bdf8;
        animation: pulse 1.2s infinite;
    }

    @@keyframes pulse {
        0%

    {
        opacity: 0.4;
    }

    50% {
        opacity: 1;
    }

    100% {
        opacity: 0.4;
    }

    }
    /* ================= CONFIDENCE BAR ================= */

    .confidence-wrapper {
        margin-bottom: 18px;
    }

    .confidence-label {
        font-size: 13px;
        margin-bottom: 8px;
        color: #94a3b8;
    }

    .confidence-bar {
        width: 100%;
        height: 12px;
        background: #020617;
        border-radius: 999px;
        border: 1px solid #1e293b;
        overflow: hidden;
    }

    .confidence-fill {
        height: 100%;
        width: 0%;
        background: linear-gradient(90deg, #38bdf8, #6366f1);
        box-shadow: 0 0 12px rgba(56,189,248,0.6);
        border-radius: 999px;
        transition: width 0.8s ease;
    }
</style>


<div class="main-container">

    <h2>AI Code Error Explainer</h2>

    <div class="analyzer-wrapper">

        <!-- LEFT -->
        <div class="panel left-panel">

<textarea id="errorInput" rows="5"
          placeholder="Paste your error here..."></textarea>

<textarea id="codeInput" rows="12"
          placeholder="Paste your code here..."></textarea>

            <div class="mode-select">
                <label>
                    <input type="radio" name="mode" value="developer" checked>
                    Developer explanation
                </label>

                <label style="margin-left:20px;">
                    <input type="radio" name="mode" value="beginner">
                    Beginner explanation
                </label>
            </div>

            <button id="analyzeBtn" onclick="sendError()">
                Analyze Error
            </button>
        </div>

        <!-- RIGHT -->
        <div class="panel">

            <div id="result" class="result-box">
                <div style="opacity:0.6">
                    Paste an error and press Analyze to get AI guidance.
                </div>
                <div id="aiReport" style="display:none;">
                    <div class="ai-title">
                        <span>AI Analysis Report</span>
                    </div>
                    <div class="ai-header">
                        <span id="riskBadge" class="risk-badge">LOW</span>
                    </div>

                    <!-- CONFIDENCE BAR -->
                    <div class="confidence-wrapper">

                        <div class="confidence-label">
                            AI Confidence:
                            <span id="confidenceText">0%</span>
                        </div>

                        <div class="confidence-bar">
                            <div id="confidenceFill" class="confidence-fill"></div>
                        </div>

                    </div>

                    <div class="ai-section">
                        <h4>Explanation</h4>
<pre id="explanationText"></pre>
                    </div>

                    <div class="ai-section">
                        <h4>Suggestion</h4>
<pre id="suggestionText"></pre>
                    </div>

                    <div class="ai-section">
                        <h4>Fixed Code</h4>
<pre id="fixedCodeText"></pre>
                    </div>

                    <div class="ai-section" id="altFixBox" style="display:none;">
                        <h4>Alternative Fix</h4>
<pre id="altFixText"></pre>
                    </div>

                </div>

            </div>
        </div>

    </div>
</div>

<script>

    let thinkingInterval = null;

    async function sendError() {

        const errorText =
            document.getElementById("errorInput").value.trim();

        const codeText =
            document.getElementById("codeInput").value.trim();

        const selectedMode =
            document.querySelector('input[name="mode"]:checked').value;

        const resultBox = document.getElementById("result");
        const btn = document.getElementById("analyzeBtn");

        if (!errorText && !codeText) {
            resultBox.innerText =
                "Please provide an error or code snippet.";
            return;
        }

        /* ---------- BUTTON STATE ---------- */

        if (btn) {
            btn.classList.add("loading");
            btn.innerText = "AI Thinking...";
            btn.disabled = true;
        }

        /* ---------- LOADING ---------- */

        resultBox.innerHTML = "<span id='thinking'>AI analyzing</span>";

        let dots = 0;

        thinkingInterval = setInterval(() => {
            const el = document.getElementById("thinking");
            if (!el) return;

            dots = (dots + 1) % 4;
            el.innerText = "AI analyzing" + ".".repeat(dots);
        }, 400);

        try {

            const response = await fetch("/api/error/analyze", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    errorMessage: errorText,
                    codeSnippet: codeText,
                    explanationMode: selectedMode
                })
            });

            if (!response.ok)
                throw new Error("API response failed");

            const data = await response.json();

            clearInterval(thinkingInterval);

            /* ---------- RISK BADGE ---------- */

            const riskLevel = (data.riskLevel || "LOW").toLowerCase();

            const badge =
                "<div class='risk-badge risk-" + riskLevel + "'>" +
                data.riskLevel.toUpperCase() + " RISK</div>";

            /* ---------- OUTPUT ---------- */

            let output =
                "Explanation:\n" + data.explanation + "\n\n" +
                "Suggestion:\n" + data.suggestion;

            if (data.fixedCode)
                output += "\n\nFixed Code:\n" + data.fixedCode;

            if (data.alternativeFix)
                output += "\n\nAlternative Fix:\n" + data.alternativeFix;

            resultBox.innerHTML =
                badge +
                "<div class='confidence-wrapper'>" +
                "<div class='confidence-label'>AI Confidence: " +
                "<span id='confidenceText'>" + data.confidence + "%</span></div>" +
                "<div class='confidence-bar'>" +
                "<div id='confidenceFill' class='confidence-fill'></div>" +
                "</div></div>" +
                "<pre style='white-space:pre-wrap;margin:0'>" +
                output +
                "</pre>";

            /* ---------- CONFIDENCE ANIMATION ---------- */

            setTimeout(() => {
                const fill = document.getElementById("confidenceFill");
                if (fill)
                    fill.style.width = data.confidence + "%";
            }, 200);
        }
        catch (err) {

            console.error(err);

            resultBox.innerText =
                "Error connecting to analysis service.";
        }

        /* ---------- BUTTON RESET ---------- */

        if (btn) {
            btn.classList.remove("loading");
            btn.innerText = "Analyze Error";
            btn.disabled = false;
        }
    }

</script>