    </style>
</head>

<body>@* 
    <div id="intro-screen">

        <div class="intro-content">

            <h1>AI Code Error Explainer</h1>

            <p>Initializing AI Debugging Environment...</p>

            <div class="loader"></div>

        </div>

    </div> *@

    <!-- TOP NAVBAR -->
    <div class="navbar">
        <div class="logo">
            AI Code Error Explainer
        </div>

        <div class="nav-links">
            <a href="/" class="@(Context.Request.Path == "/" ? "active" : "")">Home</a>
            <a href="/error" class="@(Context.Request.Path.StartsWithSegments("/error") ? "active" : "")">Analyzer</a>
            <a href="/history" class="@(Context.Request.Path.StartsWithSegments("/history") ? "active" : "")">History</a>
        </div>
    </div>


    <!-- PAGE CONTENT -->
    <div class="container">
        @RenderBody()
    </div>

    @RenderSection("Scripts", required: false)
    <!-- SECOND NAV (IDENTITY NAV) -->
    <nav class="main-nav">
        <div class="nav-container">

            <a href="/" class="logo">AI Error Platform</a>
            <span style="opacity:0.6; font-size:13px;">
                AI Assistant Online
            </span>
            <ul class="nav-links">
                <li class="nav-item">
                    <a href="/error">Analyzer</a>
                </li>

                <li class="nav-item">
                    <a href="/history">History</a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Home" asp-action="About">About</a>
                </li>
            </ul>

            <partial name="_LoginPartial" />

        </div>
    </nav>
</body>
</html>
