<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - AI Code Error Explainer</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <style>
        body {
            margin: 0;
            background: #020617;
            color: #e5e7eb;
            font-family: Consolas, monospace;
        }

        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 40px;
            background: #0f172a;
            border-bottom: 1px solid #1e293b;
        }

        .logo {
            font-weight: bold;
            color: #38bdf8;
            font-size: 18px;
        }

        .nav-links a {
            margin-left: 25px;
            text-decoration: none;
            color: #94a3b8;
            transition: 0.2s;
        }

            .nav-links a:hover {
                color: #38bdf8;
            }

        .active {
            color: #38bdf8 !important;
            border-bottom: 2px solid #38bdf8;
            padding-bottom: 4px;
        }

        .container {
            max-width: 1100px;
            margin: 50px auto;
            padding: 0 25px;
        }

        @@media (max-width: 768px) {
            .navbar

        {
            flex-direction: column;
            align-items: flex-start;
        }

        .nav-links {
            margin-top: 15px;
        }

            .nav-links a {
                display: block;
                margin: 8px 0;
            }

        }

        .main-nav {
            background: #0f172a;
            padding: 14px 0;
            border-bottom: 1px solid #1e293b;
        }

        .nav-container {
            max-width: 1100px;
            margin: auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            color: #38bdf8;
            font-weight: bold;
            text-decoration: none;
            font-size: 18px;
        }

        .nav-links a {
            margin-left: 20px;
            color: #e5e7eb;
            text-decoration: none;
            font-size: 14px;
        }

            .nav-links a:hover {
                color: #38bdf8;
            }
    </style>
</head>

<body>

    <div class="navbar">
        <div class="logo">
            AI Code Error Explainer
        </div>

        <div class="nav-links">
            <a href="/" class="@(Context.Request.Path == "/" ? "active" : "")">Home</a>
            <a href="/error" class="@(Context.Request.Path.StartsWithSegments("/error") ? "active" : "")">Analyzer</a>
            <a href="/history" class="@(Context.Request.Path.StartsWithSegments("/history") ? "active" : "")">History</a>
        </div>
    </div>

    <div class="container">
        @RenderBody()
    </div>

</body>
<nav class="main-nav">
    <div class="nav-container">
        <a href="/" class="logo">AI Error Platform</a>

        <div class="nav-links">
            <a href="/error">Analyzer</a>
            <a href="/history">History</a>
            <a href="/home/about">About</a>
        </div>
    </div>
</nav>
</html>
