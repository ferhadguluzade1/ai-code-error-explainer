@{
    ViewData["Title"] = "Dashboard";
}

<style>
    body {
        background: #020617;
        color: #e5e7eb;
        font-family: Consolas, monospace;
    }

    .dashboard {
        max-width: 1100px;
        margin: 60px auto;
        padding: 20px;
    }

    h1 {
        color: #38bdf8;
        margin-bottom: 10px;
        text-shadow: 0 0 12px rgba(56,189,248,0.2);
    }

    .subtitle {
        color: #94a3b8;
        margin-bottom: 40px;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(260px,1fr));
        gap: 25px;
    }

    .card {
        background: #0b1220;
        border: 1px solid #1e293b;
        border-radius: 14px;
        padding: 24px;
        transition: .25s;
        cursor: pointer;
        text-decoration: none;
        color: white;
    }

        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 0 20px rgba(56,189,248,0.15);
            border-color: #38bdf8;
        }

        .card h3 {
            color: #38bdf8;
            margin-bottom: 10px;
        }

        .card p {
            color: #cbd5f5;
            font-size: 14px;
        }
</style>

<div class="dashboard">

    <h1>AI Code Error Explainer</h1>
    <div class="subtitle">
        Analyze errors, learn patterns, and improve debugging skills.
    </div>

    <div class="grid">

        <a href="/Error" class="card">
            <h3>Error Analyzer</h3>
            <p>
                Paste your exception and code to receive structured explanations,
                fixes and risk analysis.
            </p>
        </a>

        <a href="/History" class="card">
            <h3>Learning History</h3>
            <p>
                Review past errors, discover recurring mistakes and learning insights.
            </p>
        </a>

        <a href="/History#mentor" class="card">
            <h3>AI Learning Mentor</h3>
            <p>
                Ask contextual questions based on your debugging history.
            </p>
        </a>

        <a href="/Home/About" class="card">
            <h3>About Project</h3>
            <p>
                Learn how the system analyzes errors using MVC architecture.
            </p>
        </a>

    </div>

</div>