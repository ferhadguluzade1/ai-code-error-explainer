    .dashboard {
        display: flex;
        gap: 20px;
        margin-top: 30px;
    }

    .card {
        flex: 1;
        background: #0b1220;
        border: 1px solid #1e293b;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
    }

    .action-btn {
        padding: 12px 24px;
        background: linear-gradient(135deg,#38bdf8,#6366f1);
        color: white;
        border-radius: 999px;
        text-decoration: none;
        margin-right: 15px;
    }
</style>

