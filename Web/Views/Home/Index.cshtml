    .dashboard {
        display: flex;
        gap: 20px;
        margin-top: 30px;
    }

    .card {
        flex: 1;
        background: #0b1220;
        border: 1px solid #1e293b;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
    }

    .action-btn {
        padding: 12px 24px;
        background: linear-gradient(135deg,#38bdf8,#6366f1);
        color: white;
        border-radius: 999px;
        text-decoration: none;
        margin-right: 15px;
    }

    #intro-screen {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: #020617;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    .intro-content {
        text-align: center;
        color: #38bdf8;
        font-family: Consolas, monospace;
    }

    .loader {
        margin-top: 25px;
        width: 50px;
        height: 50px;
        border: 5px solid #1e293b;
        border-top: 5px solid #38bdf8;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        0%

    {
        transform: rotate(0deg);
    }

    100% {
        transform: rotate(360deg);
    }

    }

