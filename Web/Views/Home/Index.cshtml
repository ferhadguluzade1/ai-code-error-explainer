@if (User.Identity.IsAuthenticated)
{
    <h2>Welcome back, @User.Identity.Name 👋</h2>
}
else
{
    <h2>Welcome to AI Error Platform</h2>
}
<div class="dashboard">

    <div class="card">
        <h3>System Status</h3>
        <p>@ViewBag.SystemStatus</p>
    </div>

    <div class="card">
        <h3>Total Analyses</h3>
        <p>@ViewBag.TotalAnalyses</p>
    </div>

    <div class="card">
        <h3>Learning State</h3>
        <p>@ViewBag.LearningState</p>
    </div>

</div>

<div class="quick-actions">
    <a href="/error" class="action-btn">Analyze Error</a>
    <a href="/history" class="action-btn">View History</a>
</div>