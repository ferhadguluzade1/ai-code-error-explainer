@{
    ViewData["Title"] = "About";
}

<style>
    body {
        background: #020617;
        color: #e5e7eb;
        font-family: Consolas, monospace;
    }

    .about-container {
        max-width: 1000px;
        margin: 60px auto;
        padding: 20px;
        line-height: 1.7;
    }

    h1 {
        color: #38bdf8;
        margin-bottom: 25px;
        text-shadow: 0 0 12px rgba(56,189,248,0.2);
    }

    h2 {
        color: #6366f1;
        margin-top: 40px;
    }

    .section {
        background: #0b1220;
        border: 1px solid #1e293b;
        border-radius: 12px;
        padding: 22px;
        margin-top: 20px;
        box-shadow: 0 0 20px rgba(0,0,0,0.35);
    }

    ul {
        padding-left: 20px;
    }

    li {
        margin-bottom: 8px;
    }
</style>

<div class="about-container">

    <h1>About AI Code Error Explainer</h1>

    <div class="section">
        <h2>Project Purpose</h2>
        <p>
            AI Code Error Explainer is an intelligent learning assistant
            designed to help developers understand errors instead of memorizing fixes.

            Built using ASP.NET MVC, Web API and AI-assisted analysis.
        </p>
        <p>
            AI Code Error Explainer is a learning-focused debugging assistant designed
            to help developers understand errors instead of memorizing fixes.
            The system analyzes exceptions, generates explanations based on user level,
            and builds a personal learning history over time.
        </p>
    </div>

    <div class="section">
        <h2>Architecture</h2>

        <ul>
            <li>ASP.NET Core MVC architecture</li>
            <li>REST API endpoints for analysis and learning</li>
            <li>Service-layer based business logic</li>
            <li>SQLite database persistence via Entity Framework Core</li>
            <li>Separation between UI, API, and logic layers</li>
        </ul>

    </div>

    <div class="section">
        <h2>Core Features</h2>

        <ul>
            <li>Error analysis with Developer / Beginner modes</li>
            <li>Risk level and confidence scoring</li>
            <li>Automatic fix suggestions</li>
            <li>Error history tracking</li>
            <li>Learning insight generation</li>
            <li>AI Mentor interaction system</li>
        </ul>

    </div>

    <div class="section">
        <h2>Learning Philosophy</h2>

        <p>
            Instead of instantly solving problems, the platform encourages developers
            to recognize patterns in their mistakes and improve debugging skills
            through repetition and contextual guidance.
        </p>

    </div>

    <div class="section">
        <h2>Technology Stack</h2>

        <ul>
            <li>ASP.NET Core (.NET 9)</li>
            <li>MVC Pattern</li>
            <li>Entity Framework Core</li>
            <li>SQLite</li>
            <li>RESTful APIs</li>
            <li>Structured AI-ready architecture</li>
        </ul>

    </div>

</div>